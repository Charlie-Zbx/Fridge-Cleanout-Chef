# Keep real credentials local. Loading a key does NOT enable paid requests.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
KITCHEN_ENABLE_LIVE=0
KITCHEN_DATA_DIR=./data
KITCHEN_HOST=127.0.0.1
KITCHEN_PORT=8000

# Optional restricted public deployment; default local mode.
KITCHEN_PUBLIC=0
KITCHEN_SECURE_COOKIE=0
KITCHEN_ACCESS_CODE=
KITCHEN_MAX_CONCURRENT=2
KITCHEN_DAILY_USER_CALLS=20
KITCHEN_DAILY_GLOBAL_CALLS=100
